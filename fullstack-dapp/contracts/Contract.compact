pragma language_version 0.22;
import CompactStandardLibrary;

// --- Ledger State ---

export sealed ledger authority: Bytes<32>;

export ledger ageCommitments: HistoricMerkleTree<10, Bytes<32>>;
export ledger residencyCommitments: HistoricMerkleTree<10, Bytes<32>>;
export ledger certCommitments: HistoricMerkleTree<10, Bytes<32>>;

export ledger usedNullifiers: Set<Bytes<32>>;

export ledger totalAgeProofs: Counter;
export ledger totalResidencyProofs: Counter;
export ledger totalCertProofs: Counter;

// --- Witnesses ---

witness localSecretKey(): Bytes<32>;
witness findAgePath(commit: Bytes<32>): MerkleTreePath<10, Bytes<32>>;
witness findResidencyPath(commit: Bytes<32>): MerkleTreePath<10, Bytes<32>>;
witness findCertPath(commit: Bytes<32>): MerkleTreePath<10, Bytes<32>>;

// --- Constructor ---

constructor(authoritySk: Bytes<32>) {
    // authoritySk is a constructor argument (witness data) — disclose required
    authority = disclose(publicKey(authoritySk));
}

// --- Helper circuits (private) ---

circuit publicKey(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>(
        [pad(32, "mydapp:pk:v1"), sk]
    );
}

circuit commitment(sk: Bytes<32>, domain: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<3, Bytes<32>>>(
        [pad(32, "mydapp:commit:v1"), domain, sk]
    );
}

export circuit getCommitment(sk: Bytes<32>, domain: Bytes<32>): Bytes<32> {
    return commitment(sk, domain);
}

circuit nullifier(sk: Bytes<32>, domain: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<3, Bytes<32>>>(
        [pad(32, "mydapp:nullify:v1"), domain, sk]
    );
}

// --- Authority circuits ---

export circuit attestAge(userCommit: Bytes<32>): [] {
    const sk = localSecretKey();
    assert(authority == disclose(publicKey(sk)), "Not the authority");
    ageCommitments.insert(disclose(userCommit));
}

export circuit attestResidency(userCommit: Bytes<32>): [] {
    const sk = localSecretKey();
    assert(authority == disclose(publicKey(sk)), "Not the authority");
    residencyCommitments.insert(disclose(userCommit));
}

export circuit attestCertification(userCommit: Bytes<32>): [] {
    const sk = localSecretKey();
    assert(authority == disclose(publicKey(sk)), "Not the authority");
    certCommitments.insert(disclose(userCommit));
}

// --- User circuits: selective proof ---

export circuit proveAge(): Boolean {
    const sk = localSecretKey();
    const domain = pad(32, "age");
    const commit = commitment(sk, domain);
    const path = findAgePath(commit);

    assert(
        ageCommitments.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))),
        "Age not attested"
    );

    const nul = nullifier(sk, domain);
    assert(!usedNullifiers.member(disclose(nul)), "Age proof already used");
    usedNullifiers.insert(disclose(nul));
    totalAgeProofs.increment(1);

    return disclose(true);
}

export circuit proveResidency(): Boolean {
    const sk = localSecretKey();
    const domain = pad(32, "residency");
    const commit = commitment(sk, domain);
    const path = findResidencyPath(commit);

    assert(
        residencyCommitments.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))),
        "Residency not attested"
    );

    const nul = nullifier(sk, domain);
    assert(!usedNullifiers.member(disclose(nul)), "Residency proof already used");
    usedNullifiers.insert(disclose(nul));
    totalResidencyProofs.increment(1);

    return disclose(true);
}

export circuit proveCertification(): Boolean {
    const sk = localSecretKey();
    const domain = pad(32, "certification");
    const commit = commitment(sk, domain);
    const path = findCertPath(commit);

    assert(
        certCommitments.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))),
        "Certification not attested"
    );

    const nul = nullifier(sk, domain);
    assert(!usedNullifiers.member(disclose(nul)), "Certification proof already used");
    usedNullifiers.insert(disclose(nul));
    totalCertProofs.increment(1);

    return disclose(true);
}